@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
find_dependency(OrthoStreamGeo)
# Private, but a static library still needs them at link time.
find_dependency(libjpeg-turbo CONFIG)
find_dependency(OpenCV CONFIG COMPONENTS core imgproc calib3d)

include("${CMAKE_CURRENT_LIST_DIR}/OrthoStreamImagingTargets.cmake")
check_required_components(OrthoStreamImaging)
