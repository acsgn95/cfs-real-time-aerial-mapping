@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
find_dependency(OrthoStreamGeo)
# Private, but a static library still needs it at link time.
find_dependency(GDAL CONFIG)
list(APPEND CMAKE_MODULE_PATH "${CMAKE_CURRENT_LIST_DIR}")
find_dependency(LASzip)

include("${CMAKE_CURRENT_LIST_DIR}/OrthoStreamMapProductsTargets.cmake")
check_required_components(OrthoStreamMapProducts)
